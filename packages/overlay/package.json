{
    "name": "@lichora/overlay",
    "version": "0.1.0",
    "private": true,
    "description": "Web-side input ownership SDK for Lichora controlled overlays.",
    "type": "module",
    "scripts": {
        "build:example": "bun scripts/build-example.ts",
